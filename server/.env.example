# Copy to server/.env and adjust.

# Port the Express API listens on. The client's VITE_API_URL must point here.
PORT=5000

# MongoDB connection string, including the database name. Alignment history is
# stored in the "alignments" collection of this database.
# Local MongoDB:  mongodb://127.0.0.1:27017/sequence_alignment_db
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>/sequence_alignment_db
MONGO_URI=mongodb://127.0.0.1:27017/sequence_alignment_db
